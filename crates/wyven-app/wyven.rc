// Icon and version info of wyven.exe (see build.rs).
1 ICON "../../assets/wyven.ico"

1 VERSIONINFO
FILEVERSION WYVEN_VERSION_NUM
PRODUCTVERSION WYVEN_VERSION_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Wyven"
      VALUE "FileDescription", "Wyven code editor"
      VALUE "FileVersion", WYVEN_VERSION_STR
      VALUE "ProductName", "Wyven"
      VALUE "ProductVersion", WYVEN_VERSION_STR
      VALUE "OriginalFilename", "wyven.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
